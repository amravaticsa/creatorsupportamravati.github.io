rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Publicly readable engagement data for CSA articles.
    // A signed-in user can create/delete only their own Like.
    match /csaArticles/{articleId}/likes/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Comments are public to read. Signed-in users can publish comments
    // under their own account; only the owner can delete their comment.
    match /csaArticles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || (request.auth.token.email == "amravati.csa@gmail.com"
            && request.auth.token.email_verified == true));
    }
  }
}