{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$sessionId": {
        ".write": true,
        ".validate": "newData.hasChildren(['connectedAt'])"
      }
    },
    "stats": {
      "lifetimeVisits": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && (data.val() == null ? newData.val() == 1 : newData.val() == data.val() + 1)"
      },
      "dailyVisitors": {
        "$date": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isNumber() && (data.val() == null ? newData.val() == 1 : newData.val() == data.val() + 1)"
        }
      },
      "pageViews": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && (data.val() == null ? newData.val() == 1 : newData.val() == data.val() + 1)"
      }
    }
  }
}